LIVE_TRADING_ENABLED=false
GUARDED_AUTOPILOT_ENABLED=false
FULLY_AUTOMATED_OPERATOR_ENABLED=false
BROKER_MODE=mock
DEFAULT_ORDER_TYPE=limit
MARKET_ORDERS_ENABLED=false
OPERATOR_KILL_SWITCH=false
DATA_MODE=fixture
# Emergency KIS paper cancellation remains disabled unless explicitly armed.
KIS_PAPER_KILL_ENABLED=false
# KIS_PAPER_KILL_CONFIRMATION=
# Optional comma-separated exact browser origins allowed to call the local API.
# QUANTPILOT_API_ALLOWED_ORIGINS=https://your-private-preview.vercel.app
# Required to authenticate state-changing operator API requests.
# QUANTPILOT_OPERATOR_SHARED_SECRET=
# QUANTPILOT_OPERATOR_ACTOR_ID=
# Required only when DATA_MODE=local_historical.
# LOCAL_DATA_DIR=C:\path\to\local\data
# Optional authoritative KRX holidays for performance valuation calendars.
# KRX_HOLIDAYS=2026-01-01,2026-02-17
# Required only when DATA_MODE=external_historical and EXTERNAL_HISTORICAL_PROVIDER=kis.
# EXTERNAL_HISTORICAL_PROVIDER=kis
# EXTERNAL_HISTORICAL_MARKET=KR_STOCK
# EXTERNAL_HISTORICAL_SYMBOLS=005930,000660
# EXTERNAL_HISTORICAL_START=2026-01-01
# EXTERNAL_HISTORICAL_END=2026-06-01
# Optional comma-separated exchange holidays that should not count as missing bars.
# EXTERNAL_HISTORICAL_HOLIDAYS=2026-01-01,2026-02-17
# EXTERNAL_HISTORICAL_ADJUSTED=false
# KIS_HISTORICAL_ENABLED=false
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCESS_TOKEN=
# Required only for the dedicated KIS paper-session job.
# QUANTPILOT_RUNTIME_ROLE=paper-session
# Required only when reading KIS paper-session status; absolute path to the session SQLite DB.
# KIS_PAPER_STATE_DB=C:\path\to\kis_paper_state.db
# KIS_PAPER_ACCOUNT_FINGERPRINT_ALLOWLIST=
# Research agents (read-only briefs and candidate notes; never a trading input).
# The job reads these from the process environment only and never opens .env.
# Naver news search — NAVER API HUB pair (preferred) or the legacy Developers Center pair.
# NCP_APIGW_API_KEY_ID=
# NCP_APIGW_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# Slack — an incoming webhook, or a bot token with a channel (SLACK_ALLOWED_USER_ID = DM to yourself).
# QUANTPILOT_SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# QUANTPILOT_SLACK_CHANNEL=
# SLACK_ALLOWED_USER_ID=
# QUANTPILOT_LEDGER_ROOT=C:\Users\<you>\investment-decisions
# QUANTPILOT_RESEARCH_MODEL=opus
# QUANTPILOT_RESEARCH_JUDGE_MODEL=fable

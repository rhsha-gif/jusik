{
  "version": 1,
  "qualitySemantics": "Each models[].quality.<kind> is the probability that this profile clears the task's verification gate on its FIRST attempt for that kind — not an abstract capability score. The objective function is minimizing the user's own intervention, so a cheaper tier is only cheaper when it does not come back for a second pass. Values move as verify-gate observations accumulate; edit them by hand only from evidence that isolates the model, not a single hard task that failed on every tier.",
  "routing": {
    "qualityTolerance": 0.01,
    "tokenTolerance": 0.08,
    "observationHalfLifeDays": 30,
    "priorWeight": 3,
    "uncertaintyPenalty": 0.02,
    "criticalMinimumSamples": 3,
    "selectionPolicy": "task-specific-priority-order",
    "latencyTolerance": 0.08,
    "defaultPriorities": [
      "quality",
      "tokens",
      "latency"
    ],
    "quota": {
      "softThresholdPercent": 40,
      "hardThresholdPercent": 10,
      "cacheTtlMinutes": 5,
      "premiumThresholdPercent": 60
    }
  },
